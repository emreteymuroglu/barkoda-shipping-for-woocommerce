# Normalise line endings to LF in the repository and in every checkout.
# WordPress coding standards require LF, and the plugin is developed on Windows.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.dist  text eol=lf

*.png   binary
*.jpg   binary
*.gif   binary
*.mo    binary

# Keep development-only files out of the distributed archive.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/composer.json  export-ignore
/composer.lock  export-ignore
/phpcs.xml.dist export-ignore
/vendor         export-ignore
