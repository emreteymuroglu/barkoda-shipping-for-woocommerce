# Normalise line endings to LF in the repository and in every checkout.
# WordPress coding standards require LF, and the plugin is developed on Windows.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.dist  text eol=lf

*.png   binary
*.jpg   binary
*.gif   binary
*.mo    binary

# Keep development-only files out of the distributed archive.
# /assets holds the wordpress.org directory graphics, which live in SVN's own assets/
# folder and must not ship inside the plugin. admin/assets is unaffected by the
# leading slash and is still included.
# Patterns need the /** form: a bare directory name matches only the directory
# entry itself, leaving the files inside it in the archive.
/assets/**      export-ignore
/.github/**     export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/composer.json  export-ignore
/composer.lock  export-ignore
/phpcs.xml.dist export-ignore
/vendor/**      export-ignore
/assets         export-ignore
/README.tr.md   export-ignore

# Translations are delivered by translate.wordpress.org once the plugin is listed,
# so the catalogues stay in the repository for translators but do not ship. Only
# the .pot travels with the plugin, as the source string list.
/languages/*.po export-ignore
/languages/*.mo export-ignore
