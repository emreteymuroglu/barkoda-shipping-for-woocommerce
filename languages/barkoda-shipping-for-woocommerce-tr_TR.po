#: admin/views/settings/defaults.php:29
msgid "Fixed Weight (grams)"
msgstr "Sabit Ağırlık (gram)"

#: admin/views/settings/defaults.php:32
msgid "grams"
msgstr "gram"

#: admin/views/settings/defaults.php:33
msgid "When \"Use a fixed default\" is selected above, every shipment uses this value. It is also the fallback in fallback mode."
msgstr "Yukarıda \"Sabit varsayılan\" seçiliyse her gönderi bu değerle gider. Fallback modunda da eşik altı için kullanılır."

#: admin/views/settings/defaults.php:37
msgid "Dimension Source"
msgstr "Boyut Kaynağı"

