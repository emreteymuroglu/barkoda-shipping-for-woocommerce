#: admin/views/settings/barcode.php:12
msgid "Barcode Range and Reference"
msgstr "Barkod Aralığı ve Referans"

#: admin/views/settings/barcode.php:13
msgid "PTT allocates you a 13-digit barcode range. The first 8 digits are a fixed prefix, the next 4 are a sequential serial number, and the last digit is an automatically calculated check digit."
msgstr "PTT size 13 haneli bir barkod aralığı tahsis eder. İlk 8 hane sabit prefix'tir, sonraki 4 hane sıralı seri numarası, son hane otomatik check digit'tir."

#: admin/views/settings/barcode.php:17
msgid "Barcode Prefix (8 digits)"
msgstr "Barkod Prefix (8 hane)"

#: admin/views/settings/barcode.php:20
msgid "The fixed 8-digit prefix stated in your PTT integration letter."
msgstr "PTT'nin entegrasyon yazısında belirtilen 8 haneli sabit prefix."

#: admin/views/settings/barcode.php:24
msgid "Serial Number Range"
msgstr "Seri Numara Aralığı"

#: admin/views/settings/barcode.php:30
msgid "The start and end serial numbers PTT allocated to you. Prefix + serial = 12 digits."
msgstr "PTT'nin tahsis ettiği başlangıç ve bitiş seri numaraları. Prefix + seri = 12 hane."

#: admin/views/settings/barcode.php:32
msgid "Next serial to be used:"
msgstr "Sıradaki kullanılacak seri:"

#. translators: %d: barcodes left in the allocated range
#: admin/views/settings/barcode.php:37
#, php-format
msgid "%d remaining"
msgstr "%d adet kaldı"

#: admin/views/settings/barcode.php:44
msgid "Customer Reference Prefix"
msgstr "Müşteri Referans Öneki"

#: admin/views/settings/barcode.php:47
msgid "A prefix added before the order ID. For example SHOP- sends SHOP-12345 to PTT. Can be left empty."
msgstr "Sipariş ID'sinin önüne eklenecek prefix. Örn: SHOP- → PTT'ye SHOP-12345 gider. Boş bırakılabilir."

#: admin/views/settings/barcode.php:53
msgid "Example:"
msgstr "Örnek:"

#: admin/views/settings/barcode.php:54
msgid "Prefix \"27918802\" + serial \"0001\" → 12 digits \"279188020001\" + check digit (automatic) → 13 digits \"2791880200017\"."
msgstr "Prefix \"27918802\" + seri \"0001\" → 12 hane \"279188020001\" + check digit (otomatik) → 13 hane \"2791880200017\"."

#: admin/views/settings/connection.php:10
msgid "PTT Connection Details"
msgstr "PTT Bağlantı Bilgileri"

#: admin/views/settings/connection.php:11
