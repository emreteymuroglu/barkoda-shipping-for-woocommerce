#. Plugin Name of the plugin
#: barkoda-shipping-for-woocommerce.php
#: includes/class-admin-page.php:56
msgid "Barkoda Shipping for WooCommerce"
msgstr "Barkoda Shipping for WooCommerce"

#. Plugin URI of the plugin
#: barkoda-shipping-for-woocommerce.php
msgid "https://github.com/emreteymuroglu/barkoda-shipping-for-woocommerce"
msgstr "https://github.com/emreteymuroglu/barkoda-shipping-for-woocommerce"

#. Description of the plugin
#: barkoda-shipping-for-woocommerce.php
msgid "Creates PTT Kargo shipments from WooCommerce orders over the PTT SOAP API, generates barcodes, prints 80mm thermal labels and tracks deliveries. Not affiliated with or endorsed by PTT."
msgstr "WooCommerce siparişlerinden PTT Kargo gönderisi oluşturur, barkod üretir, 80mm termal etiket basar ve gönderi takibi yapar. PTT ile bağlantılı ya da PTT tarafından onaylanmış değildir."

#. Author of the plugin
#: barkoda-shipping-for-woocommerce.php
msgid "Emre Teymuroglu"
msgstr "Emre Teymuroglu"

