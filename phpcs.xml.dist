<?xml version="1.0"?>
<ruleset name="PTT Kargo for WooCommerce">
	<description>Coding standards for the PTT Kargo for WooCommerce plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<!-- Show sniff codes and progress; colourise when the terminal supports it. -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- The plugin targets PHP 7.4+ and WordPress 6.0+. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!--
		Short array syntax is used throughout, as it is in WooCommerce itself.
		WPCS still prefers array(), which is a style preference rather than a
		review requirement, so the sniff is switched off instead of churning
		~290 lines to satisfy it.
	-->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>

	<!-- Yoda conditions hurt readability more than they prevent bugs here. -->
	<rule ref="WordPress.PHP.YodaConditions">
		<severity>0</severity>
	</rule>

	<!-- Every translatable string must use this text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ptt-kargo-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- Globals, hooks and constants must carry one of these prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ptt_kargo_wc"/>
				<element value="PTT_Kargo_WC"/>
				<element value="PTT_KARGO_WC"/>
			</property>
		</properties>
		<!--
			The files in admin/views are template partials, included from inside a
			method, so their top-level variables are function-scoped at runtime.
			PHPCS analyses each file in isolation and cannot see that, so it reports
			every template variable as an unprefixed global.
		-->
		<exclude-pattern>/admin/views/*</exclude-pattern>
	</rule>

	<!-- The label renderer intentionally emits a full pre-escaped HTML document. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/includes/class-label.php</exclude-pattern>
	</rule>
</ruleset>
